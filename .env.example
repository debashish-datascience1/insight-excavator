# ── Choose your LLM provider ──────────────────────────────────
# Options: azure | openai | compatible
LLM_PROVIDER=openai

# ── Option A: Standard OpenAI (easiest to get started) ────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini          # or gpt-4o; gpt-4o-mini is cheapest

# ── Option B: Azure OpenAI (preferred for hackathon scoring) ──
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01

# ── Option C: Groq (free tier, very fast) ─────────────────────
# LLM_PROVIDER=compatible
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=gsk_...
# OPENAI_COMPATIBLE_MODEL=llama-3.3-70b-versatile

# ── Option D: Ollama (fully local, free, no internet needed) ──
# LLM_PROVIDER=compatible
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=ollama
# OPENAI_COMPATIBLE_MODEL=llama3.2

# ── Option E: OpenRouter (100+ models, has free models) ───────
# LLM_PROVIDER=compatible
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_API_KEY=sk-or-...
# OPENAI_COMPATIBLE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Pipeline tuning ───────────────────────────────────────────
SIGNIFICANCE_THRESHOLD=0.05
VERIFY_LOOP_ROUNDS=2
MAX_HYPOTHESES_PER_ROUND=15
LLM_CACHE_ENABLED=true
